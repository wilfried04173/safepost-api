# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
# Atlas -> Connect -> Drivers -> copy the SRV string, then add the db name
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/safepost?retryWrites=true&w=majority

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173

# ---- Seed admin (used only by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=admin@safepost.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=SafePost Agency

# ---- Outgoing email ("forgot password" on the admin login page) ----
# Any SMTP account works (Gmail needs an "app password", not the account
# password, if 2FA is on: https://myaccount.google.com/apppasswords).
# Without these three set, the forgot-password endpoint fails cleanly with a
# clear error instead of crashing - the admin's current password is untouched.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if unset.
SMTP_FROM=
# Fixed destination for the regenerated password - not the admin account's
# own email, deliberately: only whoever has this inbox learns the new password.
PASSWORD_RESET_EMAIL=tchoumenestive@gmail.com
