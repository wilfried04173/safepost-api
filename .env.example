# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
# Atlas -> Connect -> Drivers -> copy the SRV string, then add the db name
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/safepost?retryWrites=true&w=majority

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173

# ---- Seed admin (used only by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=admin@safepost.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=SafePost Agency
